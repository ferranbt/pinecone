//@version=5
indicator("array/array_search")
b = array.from(1.0, 3.0, 5.0, 7.0)
log.info(str.tostring(array.binary_search_leftmost(b, 4.0)))
log.info(str.tostring(array.binary_search_rightmost(b, 4.0)))
log.info(str.tostring(array.binary_search_leftmost(b, 5.0)))
log.info(array.join(array.slice(array.from(10.0,20.0,30.0,40.0), 1, 3), ","))
s = array.from(1.0, 2.0, 3.0, 4.0)
log.info(str.tostring(array.percentile_nearest_rank(s, 50)))
log.info(str.tostring(array.percentile_linear_interpolation(s, 50)))
log.info(str.tostring(array.percentrank(s, 2)))
// Expected output:
// 1
// 2
// 2
// 20,30
// 2
// 2.5
// 66.66666666666666
