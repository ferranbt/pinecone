//@version=6
indicator("loops/for_by_step")
// `for … to … by <step>`: step is a positive magnitude; direction comes from
// from-vs-to, so `for i = 10 to 0` counts down.

up = 0.0
for i = 0 to 10 by 2
    up := up + i          // 0+2+4+6+8+10 = 30

down = 0.0
for i = 3 to 0
    down := down + i      // 3+2+1+0 = 6

downstep = 0.0
for i = 10 to 0 by 5
    downstep := downstep + i   // 10+5+0 = 15

log.info(str.tostring(up) + " " + str.tostring(down) + " " + str.tostring(downstep))

// Expected output:
// 30 6 15
