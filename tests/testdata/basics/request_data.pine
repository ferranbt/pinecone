//@version=6
indicator("basics/request_data")
// Skip PineTS: request.* fundamental/economic/FX feeds are not modeled by PineTS,
// and there is no provider wired here, so everything is na (par for same currency).
log.info(str.tostring(request.financial("AAPL", "TOTAL_REVENUE", "FY")))
log.info(str.tostring(request.dividends("NASDAQ:AAPL")) + "," + str.tostring(request.earnings("NASDAQ:AAPL")))
log.info(str.tostring(request.splits("NASDAQ:AAPL")) + "," + str.tostring(request.economic("US", "GDP")))
log.info(str.tostring(request.currency_rate("USD", "USD")) + "," + str.tostring(request.currency_rate("USD", "EUR")))
log.info(str.tostring(request.quandl("FRED/GDP")) + "," + str.tostring(request.seed("src", "sym", close)) + "," + str.tostring(request.footprint()))
// Expected output:
// NaN
// NaN,NaN
// NaN,NaN
// 1,NaN
// NaN,NaN,NaN
