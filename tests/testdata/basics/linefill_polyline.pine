//@version=6
indicator("basics/linefill_polyline")
// Skip PineTS: linefill/polyline drawing objects are not modeled by PineTS.
l1 = line.new(0, 1.0, 5, 2.0)
l2 = line.new(0, 3.0, 5, 4.0)
lf = linefill.new(l1, l2, color.red)
log.info(str.tostring(linefill.get_line1(lf)) + "," + str.tostring(linefill.get_line2(lf)))
linefill.set_color(lf, color.blue)
linefill.delete(lf)

p1 = chart.point.from_index(1, 10.0)
p2 = chart.point.from_index(2, 20.0)
p3 = chart.point.from_index(3, 15.0)
pl = polyline.new(array.from(p1, p2, p3), closed = true, line_width = 2)
log.info(str.tostring(pl))
polyline.delete(pl)

log.info(str.tostring(array.size(linefill.all)) + "," + str.tostring(array.size(polyline.all)))
// Expected output:
// 0,1
// 0
// 0,0
