//@version=5
indicator("series/index_call_history")
// Regression: history-indexing a call result must equal assigning it first then
// indexing. Each line is `direct | via-variable`; the two sides match every bar
// (both na during warm-up, then equal). Directly indexing the warm-up na must
// not error.
// Bars: 25

direct = ta.highest(high, 20)[1]
h = ta.highest(high, 20)
viavar = h[1]

log.info(str.tostring(direct) + " | " + str.tostring(viavar))

