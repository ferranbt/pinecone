//@version=5
indicator("ta/macd")
// Bars: 10
[m, s, h] = ta.macd(close, 3, 5, 3)
log.info(str.tostring(math.round(m, 5)) + "," + str.tostring(math.round(s, 5)) + "," + str.tostring(math.round(h, 5)))

// Expected output:
// NaN,NaN,NaN
// NaN,NaN,NaN
// NaN,NaN,NaN
// NaN,NaN,NaN
// 1,NaN,NaN
// 1,NaN,NaN
// 1,1,0
// 1,1,0
// 1,1,0
// 1,1,0
