//@version=5
indicator("ta/dmi")
// Bars: 10
[dip, dim, adx] = ta.dmi(3, 3)
log.info(str.tostring(math.round(dip, 3)) + "," + str.tostring(math.round(dim, 3)) + "," + str.tostring(math.round(adx, 3)))
// Expected output:
// NaN,NaN,NaN
// NaN,NaN,NaN
// NaN,NaN,NaN
// 10,0,NaN
// 10,0,NaN
// 10,0,100
// 10,0,100
// 10,0,100
// 10,0,100
// 10,0,100
