{
  "name": "pinecone",
  "displayName": "Pine Script (pinecone)",
  "description": "Pine Script language support: diagnostics, lint and formatting via the pinecone language server.",
  "version": "0.2.3",
  "publisher": "ferranborreguero",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ferranbt/pinecone"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pine",
        "aliases": [
          "Pine Script",
          "pine"
        ],
        "extensions": [
          ".pine"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pine",
        "scopeName": "source.pine",
        "path": "./syntaxes/pine.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Pine Script",
      "properties": {
        "pinecone.server.path": {
          "type": "string",
          "default": "pinecone",
          "description": "Path to the `pinecone` executable used as the language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "compile-tests": "tsc -p ./",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "pretest": "npm run compile-tests && npm run compile",
    "test": "node ./out/test/runTest.js",
    "pack": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "esbuild": "^0.24.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^2.3.9",
    "glob": "^10.3.10",
    "mocha": "^10.3.0",
    "typescript": "^5.4.0"
  }
}