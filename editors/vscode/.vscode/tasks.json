{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo: build pinecone",
      "type": "shell",
      "command": "cargo build -p pinecone",
      "options": { "cwd": "${workspaceFolder}/../.." },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "npm: compile",
      "type": "npm",
      "script": "compile",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build",
      "dependsOn": ["cargo: build pinecone", "npm: compile"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
